# Valores do build de produção (npm run build), usados no deploy da Vercel.
# Variáveis definidas no painel da Vercel têm prioridade sobre este arquivo.

# Consome a API real (nunca os dados de demonstração guardados no navegador)
VITE_USE_MOCKS=false

# Demonstração: selo no painel e acesso rápido no login (false quando houver dados reais)
VITE_MODO_DEMO=true

# VITE_API_URL fica no painel da Vercel: https://SUA-API.onrender.com/api
